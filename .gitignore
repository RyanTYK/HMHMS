# Root gitignore for HMHMS

# Node / tooling caches
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
.eslintcache
.stylelintcache
.nyc_output/
coverage/
.parcel-cache/
.turbo/
.vite/
**/.vite/
*.tsbuildinfo

# Build output
build/
dist/
**/dist/

# Env files (keep only examples)
.env
.env.local
.env.*.local
**/.env
**/.env.local
**/.env.*.local
!backend/example.env
!frontend/.env.example

# Logs / pids / temp
logs/
*.log
pids/
*.pid
*.pid.lock
tmp/
temp/

# IDE / OS
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
.idea/
*.iml
.DS_Store
Thumbs.db
Desktop.ini

# Project-specific
backend/worker.lock

# Personal Claude Code settings (not shared with the team)
.claude/settings.local.json
