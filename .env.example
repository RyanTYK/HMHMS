# ---------------------------------------------------------------------------
# HMHMS - Docker Compose configuration
#
# Copy this file to ".env" (same folder as docker-compose.yml) and fill it in.
# Compose reads ".env" automatically; it is git-ignored so secrets stay local.
# ---------------------------------------------------------------------------

# Port the web UI is published on. Open http://localhost:<HTTP_PORT>
HTTP_PORT=8080

# The address users actually browse to. Used for CORS, verification-email links
# and the OAuth callback. To let phones/other machines reach it, set this to
# your LAN IP, e.g. http://10.180.11.78:8080
PUBLIC_URL=http://localhost:8080

TZ=Asia/Kuala_Lumpur

# --- Build ----------------------------------------------------------------
# npm registry used when building the images. Leave blank for the public
# registry. Required on corporate networks that block registry.npmjs.org
# (symptom: "Exit handler never called" / TLS_ALERT_HANDSHAKE_FAILURE during
# build). Find yours with:  npm config get registry
NPM_REGISTRY=

# --- Database -------------------------------------------------------------
# These are only used inside the Docker network; the DB port is NOT published.
DB_NAME=hmhms_db
DB_USER=hmhms
DB_PASS=change_me_db_password
DB_ROOT_PASSWORD=change_me_root_password

# --- Email - REQUIRED -------------------------------------------------------
# New accounts must click a verification link before they can log in, so
# without a working SMTP config nobody can ever finish registering. The
# stack will refuse to start if SMTP_HOST/SMTP_USER/SMTP_PASS are blank.
# For Gmail: enable 2FA on the account, then generate an "App Password" at
# https://myaccount.google.com/apppasswords and use that as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Security -------------------------------------------------------------
# Optional. Leave blank and the backend generates one automatically on first
# boot and persists it in the database, so restarts don't log everyone out.
# Set your own here only if you need a fixed value (e.g. multiple backend
# instances sharing one secret). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Worker tuning --------------------------------------------------------
# Must comfortably exceed (number of active monitors / 2), otherwise checks
# fall behind their configured intervals when hosts are down.
MAX_CONCURRENT_CHECKS=60
CHECK_INTERVAL_MS=5000
# Max seconds a single check may sleep between retries. Blank = auto
# (half the monitor's interval, minimum 5s).
MAX_RETRY_BUDGET_SECONDS=
LOG_RETENTION_DAYS=7

# --- Microsoft OAuth (optional) -------------------------------------------
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_CALLBACK_URL=http://localhost:8080/api/auth/microsoft/callback
