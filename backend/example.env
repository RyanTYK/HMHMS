# HMHMS Backend Environment Configuration

# ======================
# Database Configuration
# ======================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root #need to change
DB_PASS= #need to change
DB_NAME=hmhms_db #need to change

# ======================
# Worker Configuration
# ======================

# Check interval for the worker (in milliseconds)
# How often the worker polls the database for due monitors
# Default: 5000 (5 seconds)
CHECK_INTERVAL_MS=5000

# Maximum number of monitors checked at the same time.
# A monitor that is DOWN holds a slot while it retries, so this must be large
# enough for your monitor count or checks will fall behind their intervals.
# Rule of thumb: at least (number of active monitors / 2).
# Default: 40
MAX_CONCURRENT_CHECKS=40

# Maximum seconds a single check may spend waiting between retries.
# Leave unset to derive it automatically from each monitor's interval
# (half the interval, minimum 5s). Set explicitly to override globally.
# MAX_RETRY_BUDGET_SECONDS=30

# Set to 'true' to log every monitor selected on each worker poll (very noisy)
# WORKER_DEBUG=false

# ======================
# Log Retention Policy
# ======================

# Number of days to retain check logs before deletion
# Default: 7
LOG_RETENTION_DAYS=7

# Batch size for log cleanup operations (number of records per batch)
# Larger batches are faster but use more memory and may lock tables longer
# Default: 1000
CLEANUP_BATCH_SIZE=1000

# ======================
# Retention Job Scheduler
# ======================

# Schedule interval for retention job (in hours)
# Default: 24 (daily)
RETENTION_SCHEDULE_HOURS=24

# Hour of day to run retention job (0-23, 24-hour format)
# Default: 2 (2 AM)
RETENTION_JOB_HOUR=2

# Run retention job immediately on startup
# Default: false
RUN_ON_STARTUP=false

# ======================
# Lock Management
# ======================

# Maximum time (in milliseconds) before a lock is considered stale
# This prevents deadlocks when processes crash without releasing locks
# Default: 30000 (30 seconds) for worker, 60000 (1 minute) for retention job
# LOCK_STALE_TIMEOUT_MS=30000

# ======================
# Application Configuration
# ======================

# Server port
PORT=3001

# JWT secret for authentication. Optional - if left blank, the backend
# generates one automatically on first boot and persists it in the database.
JWT_SECRET=

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Frontend URL (for OAuth redirects and email links)
FRONTEND_URL=http://localhost:5173

# ======================
# Microsoft OAuth (Azure AD)
# ======================

# Get these from Azure Portal > App registrations
# 1. Go to portal.azure.com
# 2. Azure Active Directory > App registrations > New registration
# 3. Name: HMHMS, Redirect URI: http://localhost:3000/auth/microsoft/callback
# 4. After registration, copy Application (client) ID and Directory (tenant) ID
# 5. Create client secret in Certificates & secrets

# Application (client) ID from Azure
MICROSOFT_CLIENT_ID=your-client-id-here

# Client secret value from Azure
MICROSOFT_CLIENT_SECRET=your-client-secret-here

# Directory (tenant) ID from Azure
# Use 'common' to allow any Microsoft account, or specific tenant ID for organization only
MICROSOFT_TENANT_ID=common

# OAuth callback URL (must match Azure app registration redirect URI)
# Development: http://localhost:3000/auth/microsoft/callback
# Production: https://yourdomain.com/auth/microsoft/callback
MICROSOFT_CALLBACK_URL=http://localhost:3000/auth/microsoft/callback

# ======================
# Email Notifications (if implemented)
# ======================

SMTP_HOST=smtp.gmail.com
# 465 for SSL (SMTP_SECURE=true), 587 for STARTTLS (SMTP_SECURE=false)
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=example@gmail.com #need to change
SMTP_PASS=examplepassword #need to change
SMTP_FROM=Host Machine Health Monitoring System <example@gmail.com> #need to change