# Backend-specific ignores

# Environment variables (keep example)
.env
.env.local
.env.*.local
!example.env

# Build artifacts
/dist/
/*.tsbuildinfo

# Node modules
/node_modules/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Worker lock file
worker.lock

# Database dumps and backups
*.sql.gz
*.sql.backup
backup/
dumps/

# Testing
coverage/
.nyc_output/

# Temporary files
*.tmp
*.temp
.cache/

# OS-specific
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db
Desktop.ini

# Editor
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
.idea/
*.swp
*.swo
*~

# Package manager
package-lock.json.bak
yarn.lock.bak
